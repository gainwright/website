# Mail settings for the forms (app/api/contact/route.ts). Copy to .env.local for local use.
# Without these, local dev prints each submission in the terminal and production returns an error.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults shown.
CONTACT_TO=hello@gainwright.ai
CONTACT_FROM="Gainwright website <hello@gainwright.ai>"
